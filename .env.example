# Set to true to simulate sending without contacting an SMTP server
DRY_RUN=true

# SMTP Settings (example: Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_demo_email@gmail.com
SMTP_PASS=your_16_char_app_password
SENDER_NAME=Automation Reminder Bot
SENDER_EMAIL=your_demo_email@gmail.com

# Scheduler interval in seconds when running in daemon/loop mode
POLL_INTERVAL_SECONDS=30